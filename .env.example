# ==============================================================
# Project Hestia
# Example deployment environment
# ==============================================================
#
# Copy this file to .env for a deployment:
#
#   cp .env.example .env
#
# NEVER commit the resulting .env file.

# Example account IDs; discover actual values with id -u and id -g.
PUID=1000
PGID=1000
TZ=America/Toronto

# Persistent application configuration
HESTIA_CONFIG_ROOT=/opt/hestia/config

# Media, downloads and transcode storage
HESTIA_DATA_ROOT=/srv/hestia/data

# Jellyfin hardware-acceleration device groups
# 44 and 993 are Atlas v1 examples, NOT universal Linux defaults.
# Replace both IDs after inspecting the deployment host; also verify /dev/dri.
# Verify these values on the deployment host with:
#   getent group video
#   getent group render
VIDEO_GID=44
RENDER_GID=993
